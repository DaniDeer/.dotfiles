#!/bin/sh
set -eu

MODULE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GIT_CONFIG_DIR="$HOME/.config/git"

GIT_USER_NAME_VALUE=${GIT_USER_NAME:-}
GIT_USER_EMAIL_VALUE=${GIT_USER_EMAIL:-}

if [ -z "$GIT_USER_NAME_VALUE" ]; then
    GIT_USER_NAME_VALUE=$(git config --global --get user.name 2>/dev/null || true)
fi

if [ -z "$GIT_USER_EMAIL_VALUE" ]; then
    GIT_USER_EMAIL_VALUE=$(git config --global --get user.email 2>/dev/null || true)
fi

cp "$MODULE_DIR/config" "$HOME/.gitconfig"

if [ -n "$GIT_USER_NAME_VALUE" ] || [ -n "$GIT_USER_EMAIL_VALUE" ]; then
    {
        printf '\n[user]\n'
        if [ -n "$GIT_USER_NAME_VALUE" ]; then
            printf '    name = %s\n' "$GIT_USER_NAME_VALUE"
        fi
        if [ -n "$GIT_USER_EMAIL_VALUE" ]; then
            printf '    email = %s\n' "$GIT_USER_EMAIL_VALUE"
        fi
    } >> "$HOME/.gitconfig"
fi

rm -f "$GIT_CONFIG_DIR/dotfiles" "$GIT_CONFIG_DIR/dotfiles-proxy"

if ! git config --global user.name >/dev/null 2>&1 || \
   ! git config --global user.email >/dev/null 2>&1; then
    printf '%s\n' 'Git identity not configured. Set GIT_USER_NAME and GIT_USER_EMAIL, then rerun ./install.' >&2
fi

if [ -n "${GH_TOKEN:-}" ]; then
    if command -v gh >/dev/null 2>&1; then
        if ! gh auth status --hostname github.com >/dev/null 2>&1; then
            printf '%s' "$GH_TOKEN" | gh auth login --hostname github.com --with-token >/dev/null
        fi
        gh auth setup-git
    else
        printf '%s\n' 'GH_TOKEN is set, but gh is not installed; GitHub authentication was skipped.' >&2
    fi
fi

printf 'Installed Git module from %s\n' "$MODULE_DIR"